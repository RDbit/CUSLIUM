const int kurog2 = 5;
const int kurog3 = 6;
const int kurog4 = 9;
const int kurog4 = 10;

void setup() {
  
  pinMode(kurog1, OUTPUT);
  pinMode(kurog2, OUTPUT);
  pinMode(kurog3, OUTPUT);
  pinMode(kurog4, OUTPUT);
  pinMode(kurog5, OUTPUT);

}

void loop() {
  // Increase brightness from 0 to 255
  for (int brightness = 0; brightness <= 255; brightness++) {
    analogWrite(ledPin, brightness); // Set the brightness of the LED
    delay(10);                       // Wait for 30 milliseconds
  }

  // Decrease brightness from 255 to 0
  for (int brightness = 255; brightness >= 0; brightness--) {
    analogWrite(ledPin, brightness); // Set the brightness of the LED
    delay(10);                       // Wait for 30 milliseconds
  }
}